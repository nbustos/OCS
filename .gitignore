__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
.jupyter_ystore.db

# Never commit participant data or derived outputs
data/
derivatives/
outputs/
dfs/
*.nii
*.nii.gz
*.gii
*.tsv
*.csv
*.xlsx
*.hdf5
*.h5
*.parquet

# Shared reference resources (public atlases, figures, summary tables) are tracked
!resources/**

# Notebook outputs (figures may contain participant-level results)
notebooks/figures/

# Script logs (contain subject IDs)
logs/


# Masks that must not be published (e.g. NM-MRI masks shared on request)
resources/private/

# Seed-based connectivity maps (participant data)
derivatives/
